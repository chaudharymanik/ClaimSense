# Supabase Postgres — pooled connection (app runtime) and direct connection (migrations).
# From the project's "Connect" dialog -> ORMs -> Prisma. URL-encode any special
# characters in the password (@ -> %40, # -> %23, etc.) or the connection string
# will silently truncate/misparse. Supabase enforces TLS on every connection
# regardless, but sslmode=require makes the client refuse a non-TLS connection
# too, rather than relying on server-side enforcement alone.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[HOST]:5432/postgres?sslmode=require"

# Google Gemini API key (free tier), used for document extraction (text + image/PDF vision).
# Get one at https://aistudio.google.com/apikey — no credit card required.
GEMINI_API_KEY="..."

# Secret seed for the demo login gate (lib/auth.ts, proxy.ts). Never
# displayed anywhere — the /login page only shows a value *derived* from
# this seed (today's date, one-way hashed), which rotates itself daily.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SEED="..."

# Separate admin credential (lib/auth.ts, /admin/*) — gates policy
# configuration and appeal-resolution, on top of (not instead of) the
# regular demo login. Unlike AUTH_SEED-derived password, this is a real,
# static secret never displayed anywhere — only the project owner should
# know it. Generate one with:
# node -e "console.log(require('crypto').randomBytes(12).toString('base64url'))"
ADMIN_PASSWORD="..."
