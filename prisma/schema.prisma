generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ClaimStatus {
  PROCESSING
  APPROVED
  REJECTED
  PARTIAL
  MANUAL_REVIEW
}

enum AppealStatus {
  PENDING
  UPHELD
  OVERTURNED
}

model Claim {
  id             String      @id @default(cuid())
  memberId       String
  memberName     String
  memberJoinDate DateTime?
  treatmentDate  DateTime
  claimAmount    Int
  hospital       String?
  cashlessRequest Boolean    @default(false)
  documentText   String?
  documentFileUrl String?
  status         ClaimStatus @default(PROCESSING)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  extractedData ExtractedData?
  decision      Decision?
  appeal        Appeal?

  @@index([memberId])
  @@index([status])
}

model ExtractedData {
  id                 String   @id @default(cuid())
  claimId            String   @unique
  claim              Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  doctorName         String?
  doctorReg          String?
  diagnosis          String?
  medicinesPrescribed Json?
  procedures         Json?
  testsPrescribed    Json?
  billedItems        Json?
  extractionConfidence Float
  createdAt          DateTime @default(now())
}

model Decision {
  id               String   @id @default(cuid())
  claimId          String   @unique
  claim            Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  decision         ClaimStatus
  approvedAmount   Int?
  deductions       Json?
  rejectionReasons Json?
  rejectedItems    Json?
  flags            Json?
  cashlessApproved Boolean?
  networkDiscount  Int?
  ruleTrail        Json
  confidenceScore  Float
  notes            String?
  nextSteps        String?
  createdAt        DateTime @default(now())
}

// One appeal per claim by design — keeps the workflow contained (no
// multi-round appeal chains). The original Decision/ruleTrail is never
// mutated; an appeal resolution is layered on top as its own record, so
// the deterministic engine's original output stays a permanent, honest
// audit trail even when an admin later overrides it.
model Appeal {
  id             String       @id @default(cuid())
  claimId        String       @unique
  claim          Claim        @relation(fields: [claimId], references: [id], onDelete: Cascade)
  reason         String
  status         AppealStatus @default(PENDING)
  resolutionNote String?
  overrideAmount Int?
  createdAt      DateTime     @default(now())
  resolvedAt     DateTime?

  @@index([status])
}

// Single-row table (fixed id) holding the editable policy configuration
// that the rules engine reads at claim-processing time. Seeded from the
// original policy_terms.json in this feature's migration. The engine falls
// back to the static POLICY constant if this row is ever missing, so a
// fresh/misconfigured database never breaks claim processing.
model PolicyConfig {
  id        String   @id @default("singleton")
  data      Json
  updatedAt DateTime @updatedAt
}
