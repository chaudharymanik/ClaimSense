# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — everything ignored except the placeholder-only template,
# which must stay committed so setup instructions (README) actually work
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# internal-only material — planning docs, design mockups, audit writeups,
# screenshots, sample documents, dev-only scripts. Never part of the
# submitted deliverable, regardless of what ends up in this folder.
/internal/
